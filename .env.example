# 定时任务用的 Anthropic API Key（以 sk-ant- 开头）
# 日常对话走 Subscription 不受影响；后台定时任务需要此 Key
# 复制本文件为 .env 并填入真实密钥：cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-api03-你的密钥

# 可选：推送通知（按需填写）
# 当前 A' 方案：邮件走 Cursor Automations 的 Resend MCP（见 scheduler/SETUP-A-prime.md）
# 收件箱写在 soul/my-soul.md「通知偏好」，不要把 Resend API Key 提交进仓库
# RESEND_API_KEY=re_你的密钥
# NOTIFY_EMAIL=zhenfengxiaoge@outlook.com
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
